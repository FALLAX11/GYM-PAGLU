# Supabase Client Configuration (Frontend - Safe to expose anon key with RLS enabled)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# App Configuration
VITE_APP_NAME="GYM PAGLU"
VITE_DEFAULT_AI_DAILY_LIMIT="30"

# ------------------------------------------------------------------
# SUPABASE EDGE FUNCTION SECRETS (NEVER put these in VITE_* or frontend!)
# Set via: supabase secrets set GROQ_API_KEY=... OPENROUTER_API_KEY=...
# ------------------------------------------------------------------
# GROQ_API_KEY="gsk_YOUR_GROQ_API_KEY"
# GROQ_MODEL="llama-3.3-70b-versatile"
# OPENROUTER_API_KEY="sk-or-v1-YOUR_OPENROUTER_API_KEY"
# OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
